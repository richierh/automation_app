{
  "template_name": "zodiac_dark",

  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "duration": 45
  },

  "background": {
    "overlay_color": "#000000",
    "overlay_opacity": 0.45,
    "blur": 0
  },

  "font": {
    "family": "Montserrat-Bold",
    "color": "#FFFFFF",
    "shadow": true
  },

  "title": {
    "font_size": 72,
    "position": {
      "x": "center",
      "y": 350
    },
    "animation": "fade_in"
  },

  "text_1": {
    "font_size": 56,
    "position": {
      "x": "center",
      "y": 700
    },
    "animation": "slide_up"
  },

  "text_2": {
    "font_size": 56,
    "position": {
      "x": "center",
      "y": 950
    },
    "animation": "slide_up"
  },

  "text_3": {
    "font_size": 56,
    "position": {
      "x": "center",
      "y": 1200
    },
    "animation": "slide_up"
  },

  "music": {
    "volume": 0.15,
    "fade_in": 1,
    "fade_out": 2
  },

  "transitions": {
    "scene_duration": 8,
    "type": "fade"
  }
}