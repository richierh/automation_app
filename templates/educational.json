{
  "template_name": "Quote_minimalist",
  "video": { "width": 1080, "height": 1920, "fps": 30, "duration": 30 },
  "theme": {
    "mood": "minimal",
    "overlay_color": "#000000",
    "overlay_opacity": 0.35
  },
  "font": {
    "family": "Poppins-SemiBold",
    "color": "#FFFFFF",
    "accent_color": "#E8E8E8",
    "shadow": false
  },
  "title": {
    "font_size": 56,
    "max_width": 900,
    "position": { "x": "center", "y": 220 },
    "animation": "fade_in",
    "box": { "enabled": false, "color": "#FFFFFF", "opacity": 0, "padding": 0 }
  },
  "text_blocks": {
    "font_size": 64,
    "max_width": 860,
    "line_spacing": 1.5,
    "animation": "fade_in",
    "position": { "x": "center", "y": 760 }
  },
  "scene": { "duration": 5, "transition": "fade" },
  "background": {
    "preferred_keywords": [
      "minimal",
      "nature",
      "calm",
      "coffee",
      "rain",
      "forest",
      "sunset",
      "ocean",
      "sky",
      "mountain"
    ]
  },
  "music": {
    "preferred_moods": ["lofi", "ambient", "piano", "calm", "relaxing"],
    "volume": 0.08
  },
  "highlight": {
    "enabled": false,
    "color": "#FFFFFF",
    "opacity": 0,
    "padding": 0
  },
  "caption": {
    "enabled": true,
    "font_size": 34,
    "color": "#F5F5F5",
    "background_color": "#000000",
    "background_opacity": 0.3,
    "padding": 16,
    "position": { "x": "center", "y": 1740 }
  }
}
