{
  "template_name": "quote_minimalist",

  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "duration": 60
  },

  "theme": {
    "mood": "minimal",
    "overlay_color": "#FFFFFF",
    "overlay_opacity": 0.20
  },

  "font": {
    "title_font": "assets/fonts/PlayfairDisplay-Bold.ttf",
    "body_font": "assets/fonts/PlayfairDisplay-Regular.ttf",
    "color": "#222222",
    "accent_color": "#B8860B",
    "shadow": false
  },

  "title": {
    "font_size": 64,
    "position": { "x": "center", "y": 280 },
    "animation": "fade"
  },

  "text_blocks": {
    "font_size": 60,
    "animation": "fade"
  },

  "scene": {
    "duration": 12,
    "transition": "fade"
  },

  "music": {
    "volume": 0.06
  }
}